{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@dsh-claude-ui/contracts/*": ["../contracts/src/*"],
      "@dsh-claude-ui/engine/node/*": ["../engine/node/*"]
    }
  },
  "include": ["src"]
}
